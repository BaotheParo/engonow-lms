<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- PII & Credential Sanitization TurboFilter -->
    <turboFilter class="com.engonow.lms.logging.PiiSanitizingLogbackFilter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [traceId=%X{traceId:-} corrId=%X{correlationId:-}] %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Project specific log levels -->
    <logger name="com.engonow.lms" level="DEBUG"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>

</configuration>
